{
  "name": "dsh-plugin-voice-mode",
  "version": "0.1.0",
  "description": "Voice mode for the DSH Web GUI: push-to-talk and hands-free dictation (Whisper/Parakeet STT), TTS replies with waveform player, magic-wand draft restructuring, swipe-to-send, and voice-command sending.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "voice",
    "speech-to-text",
    "text-to-speech",
    "push-to-talk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erkkimon/dsh-plugin-voice-mode.git"
  }
}
